<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Id="NexoAIVision"
           Name="NexoAI Vision"
           Manufacturer="NexoAI Vision Project"
           Language="1033"
           Version="$(var.MsiVersion)"
           UpgradeCode="88A886C2-8F6D-4669-B6FB-7DFC1E7B0397"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="NexoAI Vision $(var.AppVersion) x64"
                        Manufacturer="NexoAI Vision Project" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of NexoAI Vision is already installed. Uninstall it before installing this older package."
                  Schedule="afterInstallInitialize" />
    <?ifdef var.CabinetCompressionLevel ?>
    <MediaTemplate EmbedCab="no" CompressionLevel="$(var.CabinetCompressionLevel)" MaximumUncompressedMediaSize="1024" CabinetTemplate="NexoAIVision{0}.cab" />
    <?else?>
    <MediaTemplate EmbedCab="no" CompressionLevel="high" MaximumUncompressedMediaSize="1024" CabinetTemplate="NexoAIVision{0}.cab" />
    <?endif?>

    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUS_COMPUTE_MODE">
      <RegistrySearch Id="PreviousNexoAIComputeMode"
                      Root="HKLM"
                      Key="SOFTWARE\NexoAI Vision"
                      Name="ComputeMode"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="LEGACY_COMPUTE_MODE">
      <RegistrySearch Id="LegacyPpeMonitorComputeMode"
                      Root="HKLM"
                      Key="SOFTWARE\NexoAI PPE Monitor"
                      Name="ComputeMode"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="COMPUTE_MODE" Value="auto" Secure="yes" />
    <!-- Default to preserving operator data. The uninstall dialog makes a
         deliberate, visible choice necessary before the data tree is removed. -->
    <Property Id="REMOVE_RUNTIME_DATA" Value="0" Secure="yes" />
    <SetProperty Id="COMPUTE_MODE" Action="RestoreLegacyComputeMode" Value="[LEGACY_COMPUTE_MODE]"
                 After="AppSearch" Sequence="both"
                 Condition="NOT PREVIOUS_COMPUTE_MODE AND LEGACY_COMPUTE_MODE AND COMPUTE_MODE=&quot;auto&quot;" />
    <SetProperty Id="COMPUTE_MODE" Action="RestoreNexoAIComputeMode" Value="[PREVIOUS_COMPUTE_MODE]"
                 After="RestoreLegacyComputeMode" Sequence="both"
                 Condition="PREVIOUS_COMPUTE_MODE AND COMPUTE_MODE=&quot;auto&quot;" />
    <Property Id="CUDA_READY" Value="0" Secure="yes" />
    <Property Id="NVIDIA_STATUS" Value="not_probed" Secure="yes" />
    <Property Id="CUDA_DETAILS" Value="CUDA not probed" Secure="yes" />
    <Property Id="ARPCOMMENTS" Value="$(var.ArpComments)" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE/releases" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Icon Id="ProductIcon" SourceFile="$(var.StageDir)\NexoAIVision.ico" />
    <Icon Id="LauncherIcon.exe" SourceFile="$(var.StageDir)\bin\NexoAIVisionLauncher.exe" />

    <Launch Condition="Installed OR COMPUTE_MODE=&quot;auto&quot; OR COMPUTE_MODE=&quot;cuda&quot; OR COMPUTE_MODE=&quot;cpu&quot;"
            Message="COMPUTE_MODE must be auto, cuda, or cpu." />

    <Binary Id="HardwareProbeCA" SourceFile="$(var.HardwareProbeCA)" />
    <CustomAction Id="DetectComputeHardware"
                  BinaryRef="HardwareProbeCA"
                  DllEntry="DetectComputeHardware"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="BlockUnavailableCuda"
                  Error="GPU (CUDA) mode requires a usable NVIDIA adapter, SM 7.5+, and CUDA Driver API 12.9+. Use COMPUTE_MODE=auto or COMPUTE_MODE=cpu; the MSI never installs display drivers." />
    <CustomAction Id="PurgeRuntimeData"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <SetProperty Id="PurgeRuntimeData"
                 Value="&quot;[System64Folder]cmd.exe&quot; /d /s /c &quot;if exist &quot;&quot;[CommonAppDataFolder]NexoAI Vision\runtime&quot;&quot; rmdir /s /q &quot;&quot;[CommonAppDataFolder]NexoAI Vision\runtime&quot;&quot;&quot;"
                 Before="PurgeRuntimeData"
                 Sequence="execute" />
    <?if $(var.HasEngineBuilder)=1 ?>
    <CustomAction Id="BuildTensorRtEngines"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <SetProperty Id="BuildTensorRtEngines"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]\bin\engine-builder\Build-EnginesOnTarget.ps1&quot; -OutputDir &quot;[INSTALLFOLDER]\bin\models&quot; -Precision fp16"
                 After="InstallFiles"
                 Sequence="execute" />
    <?endif?>

    <InstallUISequence>
      <Custom Action="DetectComputeHardware"
              Before="CostFinalize"
              Condition="NOT Installed" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectComputeHardware"
              Before="LaunchConditions"
              Condition="NOT Installed" />
      <Custom Action="BlockUnavailableCuda"
              After="DetectComputeHardware"
              Condition="NOT Installed AND COMPUTE_MODE=&quot;cuda&quot; AND CUDA_READY&lt;&gt;&quot;1&quot;" />
      <Custom Action="PurgeRuntimeData"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND REMOVE_RUNTIME_DATA=&quot;1&quot;" />
      <?if $(var.HasEngineBuilder)=1 ?>
      <!-- Component_6cabd30d194a856b37d518e9 is the deterministic component that owns
           bin\engine-builder\Build-EnginesOnTarget.ps1 (SHA-256 of the lowercased
           relative path, first 24 hex chars, generated by Write-PayloadSource). -->
      <Custom Action="BuildTensorRtEngines"
              Before="InstallFinalize"
              Condition="NOT Installed AND $Component_6cabd30d194a856b37d518e9=3" />
      <?endif?>
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <UI Id="NexoAIComputeUI">
      <Dialog Id="ComputeDlg" Width="370" Height="270" Title="NexoAI Vision - Compute">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <?if $(var.HasModels)=1 ?>
          <Publish Event="NewDialog" Value="CustomizeDlg" />
          <?else?>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
          <?endif?>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="260" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose the compute mode" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Auto prefers a ready NVIDIA GPU and otherwise uses CPU. The installer never installs or changes display drivers." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="ProbeStatus" Type="Text" X="25" Y="58" Width="320" Height="34" NoPrefix="yes"
                 Text="NVIDIA/CUDA status: [NVIDIA_STATUS] | [CUDA_DETAILS]" />
        <Control Id="ComputeModeSelection" Type="RadioButtonGroup" X="25" Y="98" Width="320" Height="66"
                 Property="COMPUTE_MODE">
          <RadioButtonGroup Property="COMPUTE_MODE">
            <RadioButton Value="auto" X="0" Y="0" Width="320" Height="17" Text="Auto (recommended)" />
            <RadioButton Value="cuda" X="0" Y="22" Width="320" Height="17" Text="GPU (CUDA)" />
            <RadioButton Value="cpu" X="0" Y="44" Width="320" Height="17" Text="CPU" />
          </RadioButtonGroup>
        </Control>
        <Control Id="UnavailableWarning" Type="Text" X="25" Y="172" Width="320" Height="38" NoPrefix="yes"
                 ShowCondition="CUDA_READY&lt;&gt;&quot;1&quot;"
                 HideCondition="CUDA_READY=&quot;1&quot;"
                  Text="GPU requires NVIDIA SM 7.5+ and CUDA Driver API 12.9+. Choose Auto or CPU when GPU is unavailable; this installer never changes drivers." />
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ComputeDlg"
               Order="5" Condition="NOT Installed" />
      <!-- MaintenanceTypeDlg sets REMOVE=ALL. Run our dialog afterwards so
           the selected data-retention policy is known before ProgressDlg. -->
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="RemoveDataDlg"
               Order="2" Condition="1" />
      <?if $(var.HasModels)=1 ?>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="ComputeDlg" Order="1" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg"
               Order="3" Condition="NOT Installed" />
      <?else?>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ComputeDlg"
               Order="3" Condition="NOT Installed" />
      <?endif?>
      <Dialog Id="RemoveDataDlg" Width="370" Height="270" Title="NexoAI Vision - Uninstall">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="NewDialog" Value="ProgressDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="260" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose what to do with local data" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Choose whether the local configuration, logs, evidence and output are retained after NexoAI Vision is removed." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="RetentionSelection" Type="RadioButtonGroup" X="25" Y="72" Width="320" Height="74"
                 Property="REMOVE_RUNTIME_DATA">
          <RadioButtonGroup Property="REMOVE_RUNTIME_DATA">
            <RadioButton Value="0" X="0" Y="0" Width="320" Height="22"
                         Text="Preserve local data (recommended)" />
            <RadioButton Value="1" X="0" Y="34" Width="320" Height="30"
                         Text="Delete all local data permanently" />
          </RadioButtonGroup>
        </Control>
        <Control Id="DataPath" Type="Text" X="25" Y="158" Width="320" Height="48" NoPrefix="yes"
                 Text="Data location: [CommonAppDataFolder]NexoAI Vision\runtime&#13;&#10;Deleting removes configuration, logs, evidence and output. This cannot be undone." />
      </Dialog>
    </UI>

    <Feature Id="MainFeature" Title="NexoAI Vision" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentGroupRef Id="RuntimeDataDirectories" />
      <?if $(var.HasModels)=1 ?>
      <ComponentGroupRef Id="ModelComponents" />
      <?endif?>
    </Feature>
    <?if $(var.HasCudaPayload)=1 ?>
    <Feature Id="CudaRuntimeFeature" Title="NVIDIA CUDA acceleration" Description="ONNX Runtime CUDA provider, installed only after a compatible NVIDIA CUDA probe succeeds." Level="1">
      <ComponentGroupRef Id="CudaPayloadComponents" />
    </Feature>
    <?endif?>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NexoAI Vision" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="APPLICATIONDATAFOLDER" Name="NexoAI Vision">
        <Directory Id="RUNTIMEFOLDER" Name="runtime">
          <Directory Id="CONFIGFOLDER" Name="config" />
          <Directory Id="OUTPUTFOLDER" Name="output" />
          <Directory Id="LOGSFOLDER" Name="logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="NexoAI Vision" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="RuntimeDataDirectories">
      <Component Id="RuntimeConfigDirectory" Directory="CONFIGFOLDER" Guid="0CE24DFA-B744-43D4-999C-4CB3886BE0A5">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeOutputDirectory" Directory="OUTPUTFOLDER" Guid="9D3B7F4F-CB4F-4E95-AF35-7DA01CA06097">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeLogsDirectory" Directory="LOGSFOLDER" Guid="8EF4EA77-F8B0-4AAE-A686-175C83C066D3">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeComputeMode" Directory="INSTALLFOLDER" Guid="599B1C29-1D13-46EF-B458-1F778E61A813">
        <RegistryValue Root="HKLM"
                      Key="SOFTWARE\NexoAI Vision"
                       Name="ComputeMode"
                       Type="string"
                       Value="[COMPUTE_MODE]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
