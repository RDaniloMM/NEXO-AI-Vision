#include <winver.h>

1 VERSIONINFO
FILEVERSION @CUAJONE_VERSION_TUPLE@
PRODUCTVERSION @CUAJONE_VERSION_TUPLE@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS @CUAJONE_VERSION_FLAGS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Nexo AI Vision Launcher\0"
            VALUE "FileVersion", "@CUAJONE_VERSION_IDENTITY@\0"
            VALUE "ProductName", "Nexo AI Vision\0"
            @CUAJONE_PRODUCT_VERSION_VALUE@
            VALUE "OriginalFilename", "NexoAIVisionLauncher.exe\0"
            VALUE "PrivateBuild", "@CUAJONE_VERSION_IDENTITY@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
