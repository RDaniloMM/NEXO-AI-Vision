#include <windows.h>
#include "cuajone/launcher_resources.h"
IDI_CUAJONE_ICON ICON "@CUAJONE_PRODUCT_ICON@"

IDD_CAMERA_PROFILE DIALOGEX 0, 0, 350, 350
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Perfil de conexión AXIS"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Nombre del perfil", -1, 10, 12, 80, 10
    EDITTEXT IDC_PROFILE_NAME, 105, 9, 230, 14, ES_AUTOHSCROLL
    LTEXT "Usuario", -1, 10, 34, 80, 10
    EDITTEXT IDC_CAMERA_USER, 105, 31, 100, 14, ES_AUTOHSCROLL
    LTEXT "Contraseña", -1, 215, 34, 55, 10
    EDITTEXT IDC_CAMERA_PASSWORD, 272, 31, 63, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Host / IP", -1, 10, 56, 80, 10
    EDITTEXT IDC_CAMERA_HOST, 105, 53, 150, 14, ES_AUTOHSCROLL
    LTEXT "Puerto", -1, 263, 56, 38, 10
    EDITTEXT IDC_CAMERA_PORT, 302, 53, 33, 14, ES_NUMBER
    LTEXT "Ruta RTSP", -1, 10, 78, 80, 10
    EDITTEXT IDC_CAMERA_PATH, 105, 75, 230, 14, ES_AUTOHSCROLL
    GROUPBOX "Video H.264 High", -1, 8, 98, 329, 157
    LTEXT "Resolución", -1, 18, 116, 75, 10
    COMBOBOX IDC_CAMERA_RESOLUTION, 105, 112, 90, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "FPS", -1, 215, 116, 40, 10
    COMBOBOX IDC_CAMERA_FPS, 272, 112, 55, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Compresión", -1, 18, 141, 75, 10
    EDITTEXT IDC_CAMERA_COMPRESSION, 105, 137, 50, 14, ES_NUMBER
    LTEXT "MBR máx. (kbit/s)", -1, 175, 141, 92, 10
    EDITTEXT IDC_CAMERA_BITRATE, 272, 137, 55, 14, ES_NUMBER
    LTEXT "Zipstream", -1, 18, 166, 75, 10
    EDITTEXT IDC_CAMERA_ZIPSTREAM, 105, 162, 50, 14, ES_NUMBER
    LTEXT "Intervalo I-frame", -1, 175, 166, 92, 10
    EDITTEXT IDC_CAMERA_IFRAME, 272, 162, 55, 14, ES_NUMBER
    CONTROL "FPS dinámico", IDC_CAMERA_DYNAMIC_FPS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 190, 100, 12
    CONTROL "Audio", IDC_CAMERA_AUDIO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 175, 190, 70, 12
    LTEXT "Bitrate: MBR  ·  Prioridad: Quality  ·  GOP: Fixed", -1, 18, 217, 290, 10
    LTEXT "Transporte cliente", -1, 10, 274, 90, 10
    COMBOBOX IDC_CAMERA_TRANSPORT, 105, 270, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Decodificación", -1, 205, 274, 68, 10
    COMBOBOX IDC_CAMERA_ACCELERATION, 272, 270, 63, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Guardar", IDOK, 215, 322, 58, 18
    PUSHBUTTON "Cancelar", IDCANCEL, 278, 322, 58, 18
END

IDD_PPE_PROFILE DIALOGEX 0, 0, 340, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Perfil de umbrales EPP"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Clase", -1, 14, 12, 120, 10
    LTEXT "Umbral", -1, 151, 12, 50, 10
    CONTROL "Gloves", IDC_PPE_ENABLED_BASE+0, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 31, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+0, 150, 27, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Person", -1, 14, 54, 120, 10
    COMBOBOX IDC_PPE_THRESHOLD_BASE+1, 150, 50, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Safety boots", IDC_PPE_ENABLED_BASE+1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 77, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+2, 150, 73, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Vest", IDC_PPE_ENABLED_BASE+2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 100, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+3, 150, 96, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Respirador", IDC_PPE_ENABLED_BASE+3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 123, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+4, 150, 119, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Tapaorejas", IDC_PPE_ENABLED_BASE+4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 146, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+5, 150, 142, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Hard hat", IDC_PPE_ENABLED_BASE+5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 169, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+6, 150, 165, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "Lentes protectores", IDC_PPE_ENABLED_BASE+6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 192, 120, 12
    COMBOBOX IDC_PPE_THRESHOLD_BASE+7, 150, 188, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Aplicar", IDOK, 230, 188, 46, 18
    PUSHBUTTON "Cancelar", IDCANCEL, 281, 188, 48, 18
END

IDD_ADVANCED_SETTINGS DIALOGEX 0, 0, 300, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración avanzada"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Analítica", -1, 12, 17, 78, 10
    COMBOBOX IDC_ADV_ANALYTICS, 100, 13, 180, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Cómputo", -1, 12, 45, 78, 10
    COMBOBOX IDC_ADV_COMPUTE, 100, 41, 180, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Tamaño inferencia", -1, 12, 73, 78, 10
    COMBOBOX IDC_ADV_IMAGE_SIZE, 100, 69, 180, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Aplicar", IDOK, 173, 105, 52, 18
    PUSHBUTTON "Cancelar", IDCANCEL, 230, 105, 52, 18
END
